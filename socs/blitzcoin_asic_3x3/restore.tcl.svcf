    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.refresh_rate_max[11:0]}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.refresh_rate_min[11:0]}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.reset}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.token_counter_override[7:0]}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.tokens_next[6:0]}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.overrun_counter}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.pull_back}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.max_tokens_local}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.overrun_emergency}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.OVERRUN_THRESHOLD}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.PERCENT_THRESHOLD}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.max_tokens_act[5:0]}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.sprint_duration[3:0]}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.counter_done}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.sprint_done}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.sprint_duration_counter[3:0]}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.d_sprint_done}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.d_counter_done}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.d_sprint_active}]} ] \
    [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i.d_sprint_counter[3:0]}]} ]

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 1536x804+0+0}] != ""} {
    window geometry "Design Browser 1" 1536x804+0+0
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i}]} ]
browser set \
    -showinternals 0 \
    -signalsort name
browser yview see [subst  {simulator::[format {:top_1:chip_i:chip_i:router_gen(8):noc_domain_socket_i:token_pm_gen:token_pm_i:Token_FSM_i}]} ]
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1010x600+516+0}] != ""} {
    window geometry "Waveform 1" 1010x600+516+0
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar visibility partial
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units fs \
    -valuewidth 75
waveform baseline set -time 0


set groupId0 [waveform add -groups {{Tile 2}}]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups {{Tile 3}}]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups {{Tile 5}}]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups {{Tile 6}}]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups {{Tile 7}}]
waveform hierarchy collapse $groupId0


set groupId0 [waveform add -groups {{Tile 8}}]


waveform xview limits 0 2000fs

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 730x250+261+564

